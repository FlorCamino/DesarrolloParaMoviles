{
  "expo": {
    "name": "Directorio de Comercios",
    "slug": "TFI-DesMov-Equipo65",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tfidesmovequipo65",
    "userInterfaceStyle": "automatic",
    "owner": "equipo65-directorio",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.equipo65.directoriocomercios"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que Directorio de Comercios use Face ID para confirmar tu identidad al reingresar."
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que Directorio de Comercios use tu cámara para escanear el código QR de las promociones."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermissions": "Permitir que Directorio de Comercios acceda a tus fotos para subir imágenes de tu comercio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que Directorio de Comercios use tu ubicación para mostrar comercios cercanos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "14bcff30-afbb-4978-a03e-7590cdfe375b"
      }
    }
  }
}

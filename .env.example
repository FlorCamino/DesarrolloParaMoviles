# Copiar a .env.local (no incluir .env.local en Git).
# Para móvil físico: usar la IP LAN real de la PC que ejecuta Docker (NO localhost).
# Ejemplo: EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
# Android Emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Para APK fuera de la misma Wi-Fi: API publicada con HTTPS.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
